# Database
DATABASE_URL=postgresql://user:password@host:5432/lughapro

# Server
PORT=8000
APP_ENV=development
LOG_LEVEL=info

# Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRY_HOURS=24

# AI Integration (Kiswahili AI tutor)
# Prefers Anthropic Claude; falls back to Groq, then an offline canned reply.
ANTHROPIC_API_KEY=sk-ant-...
GROQ_API_KEY=your_groq_api_key_here
AI_DAILY_FREE_LIMIT=10

# Payments
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
PLATFORM_FEE_BPS=1500

# Blockchain Integration (Stellar Soroban)
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_ADMIN_SECRET_KEY=S...
STELLAR_SOROBAN_CONTRACT_ID=your_contract_id_here
CUSTODIAL_MASTER_SECRET=your_master_secret_here

# Deployed Soroban contract addresses (from `stellar contract deploy`)
CREDIT_LEDGER_CONTRACT=C...
CERTIFICATE_CONTRACT=C...
COURSE_PAYMENT_CONTRACT=C...
SESSION_ESCROW_CONTRACT=C...
